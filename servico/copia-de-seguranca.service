# Cópia de segurança do agente de editais. Corre pelo copia-de-seguranca.timer.
#
#   sudo cp servico/copia-de-seguranca.service servico/copia-de-seguranca.timer \
#        /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now copia-de-seguranca.timer
#
# Para correr já, e ver se funciona:
#   sudo systemctl start copia-de-seguranca.service
#   journalctl -u copia-de-seguranca -n 20

[Unit]
Description=Cópia de segurança do agente de editais
# A partilha de destino tem de estar montada antes. O RequiresMountsFor faz o
# systemd montá-la (pelo /etc/fstab) e não correr a cópia se falhar.
RequiresMountsFor=/mnt/copias

[Service]
Type=oneshot
Environment=RAIZ=/opt/agente-editais
Environment=DESTINO=/mnt/copias/agente-editais
Environment=DIAS=60
ExecStart=/opt/agente-editais/servico/copia-de-seguranca.sh

# Unidade systemd do agente de editais.
#
# Instalação:
#   sudo cp servico/agente-editais.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now agente-editais
#   systemctl status agente-editais
#   journalctl -u agente-editais -f          (o registo também vai para diario/)
#
# Ajuste User, Group e os caminhos antes de instalar.

[Unit]
Description=Agente de editais do expositor municipal
Documentation=file:/opt/agente-editais/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=editais
Group=editais
WorkingDirectory=/opt/agente-editais
ExecStart=/opt/agente-editais/.venv/bin/python /opt/agente-editais/agente.py --painel

# Reiniciar sempre, com espera entre tentativas. O agente é um serviço de
# apresentação: se morrer às três da manhã, ninguém o vai levantar à mão, e a
# televisão fica a mostrar editais velhos sem que ninguém perceba porquê.
Restart=always
RestartSec=10s

# A composição de imagens 4K é o que mais consome; este tecto é folgado para o
# trabalho normal e evita que uma fuga de memória leve a máquina inteira.
MemoryMax=2G

# --- Restrições de superfície ---
# A minimização de privilégios que o DL n.º 125/2025 (NIS2) espera de quem opera
# um serviço público. Nenhuma destas linhas muda o que o agente faz; todas
# reduzem o que ele conseguiria fazer se fosse comprometido.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
# Só estas pastas são escrevíveis. Se um dia o agente passar a escrever noutro
# sítio, é aqui que se declara.
#
# A RAIZ está na lista, e não estava — era um defeito, e dos maus. O
# `registo_entrada.json`, o `utilizadores.json` e o `registo_auditoria.jsonl`
# vivem na raiz do projeto, e a gravação atómica cria o temporário na MESMA
# pasta do destino (tem de ser: `os.replace` só é atómico dentro do mesmo
# sistema de ficheiros). Sem a raiz escrivível, o serviço arrancava, o /saude
# respondia, e NADA se gravava: nem uma conta, nem um edital, nem uma linha de
# auditoria. O comentário que aqui estava prometia que a falha seria «clara em
# vez de silenciosa», e foi exatamente ao contrário.
#
# O custo: o código passa a ser escrivível pelo utilizador do serviço. É uma
# troca consciente, e a alternativa mais apertada está no LEIAME — passa por
# `StateDirectory=`, que a documentação do systemd diz excluir a pasta do efeito
# do `ProtectSystem=`, com o `config.json` a apontar o estado para lá. Não vai
# já porque mudar onde o estado vive faz uma instalação existente deixar de
# encontrar o registo dela, e isso perde-se uma vez só.
ReadWritePaths=/opt/agente-editais \
               /opt/agente-editais/entrada /opt/agente-editais/saida \
               /opt/agente-editais/previas /opt/agente-editais/originais \
               /opt/agente-editais/arquivo /opt/agente-editais/fundos \
               /opt/agente-editais/trabalho /opt/agente-editais/diario
# O painel não precisa de rede para lá de IPv4/IPv6 locais.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target

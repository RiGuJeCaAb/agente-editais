# Configuração local (contém a senha do painel) — nunca versionar.
config.json

# Dados de execução: estado, registos e trilho de auditoria são do posto, não do código.
estado.json
editais.json
registo_entrada.json
registo_auditoria.jsonl
retiradas.txt
*.bak.[0-9]
*.tmp

# Contas do painel. As senhas estão derivadas e não em claro, mas este ficheiro
# não tem nada que fazer num repositório: é do posto, e versioná-lo levaria as
# contas reais de um município para dentro do histórico do Git.
utilizadores.json

# Pastas de trabalho e saída.
diario/
entrada/*
!entrada/_COLOCAR_DOCUMENTOS_AQUI.txt
saida/
previas/
trabalho/
fundos/
originais/
diario/
arquivo/*
!arquivo/_ARQUIVO.txt

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
